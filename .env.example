APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengembangan: MAIL_MAILER=log (email hanya ditulis ke storage/logs/laravel.log).
# Kirim sungguhan: ganti ke smtp lalu isi di bawah. Tes dengan: php artisan mail:test emailmu@gmail.com
# Contoh Gmail (wajib "App Password", bukan password biasa):
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=emailmu@gmail.com  MAIL_PASSWORD=app-password-16-huruf
# Panduan lengkap: docs/SETUP_GOOGLE_DAN_EMAIL.md
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login dengan Google (kosongkan = tombol Google disembunyikan). Panduan: docs/SETUP_GOOGLE_DAN_EMAIL.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Biarkan kosong -> otomatis APP_URL/auth/google/callback
GOOGLE_REDIRECT_URI=

# Midtrans (payment gateway). Sandbox: https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Kosongkan = otomatis (verifikasi ke API Midtrans hanya di produksi). Isi true/false untuk memaksa.
MIDTRANS_VERIFY_STATUS_API=
# Batas waktu bayar di halaman Midtrans (menit). Tidak akan melewati batas 24 jam pesanan.
MIDTRANS_EXPIRY_MINUTES=1440
# Notification URL yang didaftarkan di dashboard Midtrans: https://DOMAIN-ANDA/webhooks/midtrans
# true (disarankan untuk mulai): notifikasi diproses langsung di dalam request, TIDAK butuh worker antrean.
# false: lewat antrean database. WAJIB menjalankan proses terpisah: php artisan queue:work --tries=6
MIDTRANS_PROCESS_INLINE=true
